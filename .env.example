# ── Groq API ──────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Supabase (Database & Auth) ─────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Note: Use your service role key so backend can bypass RLS for insertions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Qdrant Cloud (Vector Database) ───────────────────────────────────
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Mode switch ───────────────────────────────────────────────────────
# "api"   = Groq Whisper + Groq LLM (recommended, no GPU needed)
# "local" = WhisperX local models (future, needs CUDA Docker image)
MODEL_MODE=api

# ── Groq Whisper (api mode) ───────────────────────────────────────────
GROQ_WHISPER_MODEL=whisper-large-v3   # or whisper-large-v3-turbo

# ── Backend ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
